class movie:
    def __init__(self,movie_name:str,total_seats:int,ticket_price:int):
        self.movie_name=movie_name
        self.total_seats=total_seats
        self.ticket_price=ticket_price
        self.booked_seats=0
    def book_ticket(self,num_tickets):
        if num_tickets > self.total_seats:
            print("sorry seats are not available for your quantity")
        else:
            self.booked_seats+=num_tickets
            self.total_seats-=num_tickets
            print("your tickets is booked")
            print(f"please pay, {num_tickets*self.ticket_price}")

    def show_status(self):
        print(f"Movie name is {self.movie_name}")
        print(f"seats avialable is {self.total_seats}")
        print(f"seats booked so far is {self.booked_seats}")
